# Google Cloud project with the Generative Language API enabled.
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Local development uses Application Default Credentials (ADC).
# Production must provide ADC through an approved workload identity source.
# Never commit credential files or tokens.

# Optional. Defaults to a Gemma 4 model supported by the Gemini API.
GEMMA_MODEL=gemma-4-26b-a4b-it

# Optional. Defaults to 3000.
PORT=3000
